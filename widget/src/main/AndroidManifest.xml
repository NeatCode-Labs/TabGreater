<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- supportsRtl mirrors :app; the preview layout uses start/end attributes, and declaring it
         here keeps the library's own lint honest about that. -->
    <application android:supportsRtl="true">

        <!-- The Glance provider. Exported because the launcher (a different process) binds it. -->
        <receiver
            android:name=".TickerWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ticker_widget_info" />
        </receiver>

        <!-- Launched by the launcher on placement and on "Reconfigure". -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_label"
            android:theme="@style/Theme.TabGreater.WidgetConfig"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

</manifest>
