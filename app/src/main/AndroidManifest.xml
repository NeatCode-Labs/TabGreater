<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TabGreaterApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TabGreater">

        <!--
            F4: the whole app is one Compose tree, so configuration changes are handled in
            composition (Compose re-reads the configuration and re-lays out; `rememberSaveable`
            state survives anyway). Declaring them here stops the chart's fullscreen orientation
            lock — and every ordinary rotation — from destroying the activity, which used to throw
            away the cached WebView's chart state and re-fetch 500 bars per toggle.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TabGreater.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                F4: tabgreater://chart/{key} opens that market's chart as the only back-stack
                entry, so Back returns to the home screen. Only this app's widgets fire it, with
                `setPackage`, hence no BROWSABLE: a browser must not be able to steer the app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="chart"
                    android:scheme="tabgreater" />
            </intent-filter>
        </activity>

        <!-- Chart share: the screenshot PNG lives under cacheDir/shared and leaves as a content URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
