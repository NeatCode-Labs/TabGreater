    <!-- About screen -->
    <string name="about_title">About TabGreater</string>
    <string name="about_version">TabGreater %1$s — a free, open-source crypto watchlist with charts and home-screen widgets. Live spot data from Binance, Gate.io, Kraken, KuCoin and MEXC.</string>
    <string name="about_independent">TabGreater is an independent open-source project by NeatCode Labs, released under the GNU General Public License v3.0 or later: you may use, study, share and improve it, and anyone who distributes a modified version must publish their source under the same licence and keep this notice. It is not affiliated with, endorsed by or sponsored by any exchange. Exchange names are trademarks of their respective owners.</string>
    <string name="about_data_title">Data sources &amp; privacy</string>
    <string name="about_data_body">Prices and candles travel straight from each exchange\'s public API to your device. TabGreater has no server, no account and no analytics, and collects nothing. Because your phone talks to the exchanges directly, your IP address and the pairs you watch are visible to the exchanges you use, under their own terms of service. Watchlists and settings stay on your device (and in your Android backup, if you have it enabled).</string>
    <string name="about_disclaimer_title">Disclaimer</string>
    <string name="about_disclaimer_body">Prices are indicative and may be delayed, incomplete or wrong. TabGreater executes no trades, holds no API keys and gives no financial advice. Use it at your own risk.</string>
    <string name="about_thirdparty_title">Third-party software</string>
    <string name="about_thirdparty_note">Thank you to everyone who builds and maintains these.</string>
    <string name="about_notice_title">Notices</string>
    <string name="about_licence_title">GNU General Public License v3</string>
    <string name="about_apache_title">Apache License 2.0 (KLineChart and libraries)</string>
    <string name="about_ofl_title">SIL Open Font License 1.1 (Righteous)</string>
    <string name="about_loading">Loading…</string>
